      "type": "telegram",
      "url": "https://t.me/EDM115bots/698"
    }
  ],
  "homepage": "https://github.com/EDM115/monorepo-hash#readme",
  "keywords": [
    "monorepo",
    "hash",
    "pnpm",
    "yarn",
    "npm",
    "bun",
    "deno"
  ],
  "license": "MIT",
  "main": "./dist/monorepo-hash.mjs",
  "module": "./dist/monorepo-hash.mjs",
  "name": "monorepo-hash",
  "packageManager": "pnpm@10.25.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EDM115/monorepo-hash.git"
  },
  "scripts": {
    "build": "tsdown && pnpm build:decoy",
    "build:bun": "pnpm build:bun:linux-x64 && pnpm build:bun:linux-arm64 && pnpm build:bun:windows-x64 && pnpm build:bun:darwin-x64 && pnpm build:bun:darwin-arm64 && pnpm build:bun:linux-x64-musl && pnpm build:bun:linux-arm64-musl && pnpm build:bun:chmod",
    "build:bun:chmod": "node -e \"const { chmodSync } = require('fs'); const { readdirSync } = require('fs'); const path = require('path'); const dir = path.join(__dirname, 'bun-build'); for (const file of readdirSync(dir)) { if (!file.includes('.')) { chmodSync(path.join(dir, file), 0o755); } }\"",
    "build:bun:darwin-arm64": "bun build --compile --minify --sourcemap --bytecode --target=bun-darwin-arm64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-darwin-arm64",
    "build:bun:darwin-x64": "bun build --compile --minify --sourcemap --bytecode --target=bun-darwin-x64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-darwin-x64",
    "build:bun:linux-arm64": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-arm64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-linux-arm64",
    "build:bun:linux-arm64-musl": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-arm64-musl ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-linux-arm64-musl",
    "build:bun:linux-x64": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-x64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-linux-x64",
    "build:bun:linux-x64-musl": "bun build --compile --minify --sourcemap --bytecode --target=bun-linux-x64-musl ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-linux-x64-musl",
    "build:bun:windows-x64": "bun build --compile --minify --sourcemap --bytecode --windows-icon=logo.ico --target=bun-windows-x64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-windows-x64",
    "build:bun:windows-x64:ci": "bun build --compile --minify --sourcemap --bytecode --target=bun-windows-x64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-windows-x64",
    "build:decoy": "node -e \"require('fs').writeFileSync('./dist/monorepo-hash.exe', '', 'utf8')\"",
    "format": "eslint -c eslint.stylistic.config.ts --concurrency=auto --fix .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --fix --type-aware .",
    "postinstall": "node -e \"const fs = require('fs'); const path = require('path'); const installBinaryPath = path.join(__dirname, 'dist', 'install-binary.mjs'); if (fs.existsSync(installBinaryPath)) { const child_process = require('child_process'); child_process.execFileSync(process.execPath, [installBinaryPath], { stdio: 'inherit' }); }\"",
    "release": "pnpm publish",
    "test": "pnpm build && vitest",
    "test:binaries": "pnpm build:bun && pnpm test:binaries:prepare && (vitest --config vitest.binaries.config.ts; code=$?; git restore src/monorepo-hash-bun.ts; exit $code)",
    "test:binaries:prepare": "node -e \"const fs=require('fs');const p='src/monorepo-hash-bun.ts';let t=fs.readFileSync(p,'utf8');t=t.replace(/\\(async \\(\\) => {[\\s\\S]*?\\/\\/ #endregion[\\r\\n]*/g,'').replace(/exit\\(\\s*(\\d+)\\s*\\)/g,(_,x)=>'if(![0,1].includes('+x+')){throw new Error(\\\"Exit with code '+x+'\\\")}');fs.writeFileSync(p,t);\"",
    "typecheck": "tsgo --noEmit"
  },
  "type": "module",
  "types": "./dist/monorepo-hash.d.mts",
  "version": "2.0.0"
}
