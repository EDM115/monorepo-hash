{
  "author": "EDM115 <npmjs@edm115.dev> (https://edm115.dev)",
  "bin": {
    "monorepo-hash": "./dist/monorepo-hash.exe",
    "monorepo-hash-js": "./dist/monorepo-hash.mjs"
  },
  "bugs": {
    "email": "npmjs@edm115.dev",
    "url": "https://github.com/EDM115/monorepo-hash/issues"
  },
  "description": "A CLI tool to generate hashes for the workspaces of your monorepo",
  "devDependencies": {
    "@stylistic/eslint-plugin": "~5.10.0",
    "@types/bun": "~1.3.10",
    "@types/node": "latest",
    "@typescript-eslint/parser": "~8.57.1",
    "@typescript/native-preview": "latest",
    "edm115-lint": "~0.2.0",
    "empathic": "~2.0.0",
    "eslint": "~10.0.3",
    "globals": "~17.4.0",
    "ignore": "~7.0.5",
    "jiti": "~2.6.1",
    "oxlint": "~1.56.0",
    "oxlint-tsgolint": "~0.17.0",
    "tinyexec": "~1.0.4",
    "tinyglobby": "~0.2.15",
    "tsdown": "~0.21.4",
    "unplugin-unused": "~0.5.7",
    "vitest": "~4.1.0",
    "yaml": "~2.8.2"
  },
  "exports": {
    ".": {
      "types": "./dist/monorepo-hash.d.mts",
      "import": "./dist/monorepo-hash.mjs"
    },
    "./install-binary": {
      "types": "./dist/install-binary.d.mts",
      "import": "./dist/install-binary.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "funding": [
    {
      "type": "paypal",
      "url": "https://www.paypal.me/8EDM115"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/edm115"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/EDM115"
    },
    {
      "type": "telegram",
      "url": "https://t.me/EDM115bots/698"
    }
  ],
  "homepage": "https://github.com/EDM115/monorepo-hash#readme",
  "inlinedDependencies": {
    "empathic": "2.0.0",
    "fdir": "6.5.0",
    "ignore": "7.0.5",
    "picomatch": "4.0.3",
    "tinyglobby": "0.2.15",
    "yaml": "2.8.2"
  },
  "keywords": [
    "monorepo",
    "hash",
    "pnpm",
    "yarn",
    "npm",
    "bun",
    "deno"
  ],
  "license": "MIT",
  "name": "monorepo-hash",
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EDM115/monorepo-hash.git"
  },
  "scripts": {
    "build": "tsdown && pnpm build:decoy",
    "build:bun": "pnpm build:bun:linux-x64 && pnpm build:bun:linux-arm64 && pnpm build:bun:windows-x64 && pnpm build:bun:darwin-x64 && pnpm build:bun:darwin-arm64 && pnpm build:bun:linux-x64-musl && pnpm build:bun:linux-arm64-musl && pnpm build:bun:windows-arm64 && pnpm build:bun:chmod",
    "build:bun:chmod": "node -e \"const { chmodSync } = require('fs'); const { readdirSync } = require('fs'); const path = require('path'); const dir = path.join(__dirname, 'bun-build'); for (const file of readdirSync(dir)) { if (!file.includes('.')) { chmodSync(path.join(dir, file), 0o755); } }\"",
    "build:bun:darwin-arm64": "bun build --compile --minify --sourcemap --bytecode --format=esm --target=bun-darwin-arm64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-darwin-arm64",
    "build:bun:darwin-x64": "bun build --compile --minify --sourcemap --bytecode --format=esm --target=bun-darwin-x64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-darwin-x64",
    "build:bun:linux-arm64": "bun build --compile --minify --sourcemap --bytecode --format=esm --target=bun-linux-arm64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-linux-arm64",
    "build:bun:linux-arm64-musl": "bun build --compile --minify --sourcemap --bytecode --format=esm --target=bun-linux-arm64-musl ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-linux-arm64-musl",
    "build:bun:linux-x64": "bun build --compile --minify --sourcemap --bytecode --format=esm --target=bun-linux-x64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-linux-x64",
    "build:bun:linux-x64-musl": "bun build --compile --minify --sourcemap --bytecode --format=esm --target=bun-linux-x64-musl ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-linux-x64-musl",
    "build:bun:windows-arm64": "bun build --compile --minify --sourcemap --bytecode --format=esm --windows-icon=logo.ico --windows-title=monorepo-hash --windows-description=monorepo-hash --windows-publisher=EDM115 --windows-version=2.0.1 --windows-copyright=https://github.com/EDM115/monorepo-hash/blob/master/LICENSE --target=bun-windows-arm64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-windows-arm64.exe",
    "build:bun:windows-arm64:ci": "bun build --compile --minify --sourcemap --bytecode --format=esm --target=bun-windows-arm64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-windows-arm64.exe",
    "build:bun:windows-x64": "bun build --compile --minify --sourcemap --bytecode --format=esm --windows-icon=logo.ico --windows-title=monorepo-hash --windows-description=monorepo-hash --windows-publisher=EDM115 --windows-version=2.0.1 --windows-copyright=https://github.com/EDM115/monorepo-hash/blob/master/LICENSE --target=bun-windows-x64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-windows-x64.exe",
    "build:bun:windows-x64:ci": "bun build --compile --minify --sourcemap --bytecode --format=esm --target=bun-windows-x64 ./src/monorepo-hash-bun.ts --outfile ./bun-build/monorepo-hash-windows-x64.exe",
    "build:decoy": "node -e \"require('fs').writeFileSync('./dist/monorepo-hash.exe', '', 'utf8')\"",
    "cli:get-bench-times": "jiti ./get-bench-times.script.ts",
    "format": "eslint -c eslint.stylistic.config.ts --concurrency=auto --fix .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "node -e \"const fs = require('fs'); const path = require('path'); const installBinaryPath = path.join(__dirname, 'dist', 'install-binary.mjs'); if (fs.existsSync(installBinaryPath)) { const child_process = require('child_process'); child_process.execFileSync(process.execPath, [installBinaryPath], { stdio: 'inherit' }); }\"",
    "release": "pnpm publish",
    "test": "pnpm build && vitest",
    "test:binaries": "pnpm build:bun && pnpm test:binaries:prepare && (vitest --config vitest.binaries.config.ts; code=$?; git restore src/monorepo-hash-bun.ts; exit $code)",
    "test:binaries:prepare": "node -e \"const fs=require('fs');const p='src/monorepo-hash-bun.ts';let t=fs.readFileSync(p,'utf8');t=t.replace(/\\(async \\(\\) => {[\\s\\S]*?\\/\\/ #endregion[\\r\\n]*/g,'').replace(/exit\\(\\s*(\\d+)\\s*\\)/g,(_,x)=>'if(![0,1].includes('+x+')){throw new Error(\\\"Exit with code '+x+'\\\")}');fs.writeFileSync(p,t);\"",
    "typecheck": "tsgo --noEmit"
  },
  "type": "module",
  "version": "2.1.1"
}
