{
  "author": "EDM115 <npmjs@edm115.dev> (https://edm115.dev)",
  "bin": {
    "monorepo-hash": "./dist/monorepo-hash.exe",
    "monorepo-hash-js": "./dist/monorepo-hash.mjs"
  },
  "bugs": {
    "email": "npmjs@edm115.dev",
    "url": "https://github.com/EDM115/monorepo-hash/issues"
  },
  "description": "A CLI tool to generate hashes for the workspaces of your monorepo",
  "devDependencies": {
    "@stylistic/eslint-plugin": "~5.10.0",
    "@types/node": "latest",
    "@typescript-eslint/parser": "~8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "edm115-lint": "~0.2.1",
    "empathic": "~2.0.1",
    "eslint": "~10.8.1",
    "globals": "~17.11.0",
    "ignore": "~7.0.6",
    "jiti": "~2.7.0",
    "oxlint": "~1.78.0",
    "oxlint-tsgolint": "~7.0.2001",
    "tinyexec": "~1.3.0",
    "tinyglobby": "~0.2.17",
    "tsdown": "~0.22.14",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "unplugin-unused": "~0.6.0",
    "vitest": "~4.1.10",
    "yaml": "~2.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/monorepo-hash.d.mts",
      "import": "./dist/monorepo-hash.mjs"
    },
    "./install-binary": {
      "types": "./dist/install-binary.d.mts",
      "import": "./dist/install-binary.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "funding": [
    {
      "type": "paypal",
      "url": "https://www.paypal.me/8EDM115"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/edm115"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/EDM115"
    },
    {
      "type": "telegram",
      "url": "https://t.me/EDM115bots/698"
    }
  ],
  "homepage": "https://github.com/EDM115/monorepo-hash#readme",
  "inlinedDependencies": {
    "empathic": "2.0.1",
    "fdir": "6.5.0",
    "ignore": "7.0.6",
    "picomatch": "4.0.5",
    "tinyglobby": "0.2.17",
    "yaml": "2.9.0"
  },
  "keywords": [
    "monorepo",
    "hash",
    "pnpm",
    "yarn",
    "npm",
    "bun",
    "deno"
  ],
  "license": "MIT",
  "name": "monorepo-hash",
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EDM115/monorepo-hash.git"
  },
  "scripts": {
    "build": "pnpm build:node && pnpm build:go && pnpm build:rust",
    "build:decoy": "node -e \"const fs = require('fs'); fs.writeFileSync('./dist/monorepo-hash.exe', '', 'utf8');\"",
    "build:go": "pnpm cli:build-bin -r go -p all && pnpm cli:chmod",
    "build:node": "tsdown && pnpm build:decoy",
    "build:rust": "pnpm cli:build-bin -r rust -p all && pnpm cli:chmod",
    "cli:build-bin": "jiti ./build.script.ts",
    "cli:chmod": "jiti ./build.script.ts --chmod",
    "cli:get-bench-graphs": "python ./bench-graphs.py",
    "cli:get-bench-times": "jiti ./get-bench-times.script.ts",
    "format": "pnpm format:ts && pnpm format:go && pnpm format:rust",
    "format:ts": "eslint -c eslint.stylistic.config.ts --concurrency=auto --fix .",
    "format:go": "gofmt -w ./src/go",
    "format:rust": "cd src/rust && cargo +nightly fmt",
    "lint": "pnpm lint:ts && pnpm lint:go && pnpm lint:rust",
    "lint:ts": "oxlint",
    "lint:go": "cd src/go && GOEXPERIMENT=jsonv2 go vet ./... && GOEXPERIMENT=jsonv2 go tool staticcheck ./...",
    "lint:rust": "cd src/rust && cargo clippy --all-targets --all-features -- -D warnings",
    "postinstall": "node './dist/install-binary.mjs'",
    "release": "pnpm publish",
    "test": "pnpm test:node && pnpm test:go && pnpm test:rust",
    "test:go": "pnpm cli:build-bin -r go -p current && pnpm cli:chmod && vitest --project go",
    "test:node": "pnpm build:node && vitest --project node",
    "test:rust": "pnpm cli:build-bin -r rust -p current && pnpm cli:chmod && vitest --project rust",
    "typecheck": "pnpm typecheck:ts && pnpm typecheck:rust",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:rust": "cd src/rust && cargo check --all-targets --all-features"
  },
  "type": "module",
  "version": "3.0.0"
}
