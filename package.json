{
  "author": "EDM115 <npmjs@edm115.dev> (https://edm115.dev)",
  "bin": {
    "monorepo-hash": "./dist/monorepo-hash.mjs",
    "monorepo-hash-bun": "./dist/monorepo-hash.exe"
  },
  "bugs": {
    "email": "npmjs@edm115.dev",
    "url": "https://github.com/EDM115/monorepo-hash/issues"
  },
  "description": "A CLI tool to generate hashes for the workspaces of your monorepo",
  "dependencies": {
    "fast-glob": "~3.3.3",
    "find-up": "~8.0.0",
    "ignore": "~7.0.5",
    "js-yaml": "~4.1.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "~5.6.1",
    "@types/fs-extra": "~11.0.4",
    "@types/js-yaml": "~4.0.9",
    "@types/node": "latest",
    "@typescript-eslint/parser": "~8.48.1",
    "edm115-lint": "~0.1.5",
    "eslint": "~9.39.1",
    "execa": "~9.6.1",
    "fs-extra": "~11.3.2",
    "globals": "~16.5.0",
    "oxlint": "~1.31.0",
    "oxlint-tsgolint": "~0.8.3",
    "tsdown": "~0.17.0",
    "typescript": "~5.9.3",
    "unplugin-unused": "~0.5.6",
    "vitest": "~4.0.15"
  },
  "exports": {
    ".": "./dist/monorepo-hash.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "funding": [
    {
      "type": "paypal",
      "url": "https://www.paypal.me/8EDM115"
    },
    {
      "type": "buymeacoffee",
