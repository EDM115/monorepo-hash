{
  "author": "EDM115 <npmjs@edm115.dev> (https://edm115.dev)",
  "bin": {
    "monorepo-hash": "./dist/monorepo-hash.exe",
    "monorepo-hash-js": "./dist/monorepo-hash.mjs"
  },
  "bugs": {
    "email": "npmjs@edm115.dev",
    "url": "https://github.com/EDM115/monorepo-hash/issues"
  },
  "description": "A CLI tool to generate hashes for the workspaces of your monorepo",
  "devDependencies": {
    "@stylistic/eslint-plugin": "~5.6.1",
    "@types/bun": "~1.3.4",
    "@types/fs-extra": "~11.0.4",
    "@types/js-yaml": "~4.0.9",
    "@types/node": "latest",
    "@typescript/native-preview": "latest",
    "@typescript-eslint/parser": "~8.49.0",
    "edm115-lint": "~0.1.6",
    "eslint": "~9.39.1",
    "execa": "~9.6.1",
    "fast-glob": "~3.3.3",
    "find-up": "~8.0.0",
    "fs-extra": "~11.3.2",
    "globals": "~16.5.0",
    "ignore": "~7.0.5",
    "js-yaml": "~4.1.1",
    "oxlint": "~1.32.0",
    "oxlint-tsgolint": "~0.8.6",
    "tsdown": "~0.17.3",
    "unplugin-unused": "~0.5.6",
    "vitest": "~4.0.15"
  },
  "exports": {
    ".": "./dist/monorepo-hash.mjs",
    "./install-binary": "./dist/install-binary.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "funding": [
    {
      "type": "paypal",
      "url": "https://www.paypal.me/8EDM115"
