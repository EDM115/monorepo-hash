{
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "TypeScriptTeam.native-preview"
  },
  "editor.tabSize": 2,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "oxlint.config.ts": "eslint.*",
    "tsdown.config.ts": "tsconfig.*",
    "package.json": ".node-version, pnpm*",
    "README.md": "LICENSE, .gitignore, CHANGELOG.md, logo.*",
    "vitest.config.ts": "vitest.*"
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "gremlins.showInProblemPane": true,
  "importCost.fontStyle": "italic",
  "importCost.largePackageDarkColor": "#FF5555",
  "importCost.largePackageLightColor": "#FF5555",
  "importCost.mediumPackageLightColor": "#50FA7B",
  "importCost.smallPackageDarkColor": "#50FA7B",
  "importCost.smallPackageLightColor": "#50FA7B",
  "js/ts.experimental.useTsgo": true,
  "js/ts.inlayHints.enumMemberValues.enabled": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "oxc.enable": true,
  "oxc.typeAware": true,
  "oxc.unusedDisableDirectives": "warn",
  "search.exclude": {
    "pnpm-lock.yaml": true
  },
  "js/ts.inlayHints.propertyDeclarationTypes.enabled": true,
}
