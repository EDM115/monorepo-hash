{
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "editor.tabSize": 2,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "Cargo.toml": "Cargo.lock",
    "go.mod": "go.sum",
    "oxlint.config.ts": "eslint.*",
    "package.json": ".node-version, pnpm*, *.script.ts, *.py",
    "README.md": "LICENSE, .gitignore, AGENTS.md, CHANGELOG.md, logo.*",
    "tsdown.config.ts": "tsconfig.*"
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "go.toolsEnvVars": {
    "GOEXPERIMENT": "jsonv2"
  },
  "gremlins.showInProblemPane": true,
  "importCost.fontStyle": "italic",
  "importCost.largePackageDarkColor": "#FF5555",
  "importCost.largePackageLightColor": "#FF5555",
  "importCost.mediumPackageLightColor": "#50FA7B",
  "importCost.smallPackageDarkColor": "#50FA7B",
  "importCost.smallPackageLightColor": "#50FA7B",
  "js/ts.inlayHints.enumMemberValues.enabled": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.inlayHints.propertyDeclarationTypes.enabled": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "oxc.enable.oxlint": true,
  "oxc.unusedDisableDirectives": "warn",
  "rust-analyzer.completion.fullFunctionSignatures.enable": true,
  "rust-analyzer.completion.termSearch.enable": true,
  "rust-analyzer.diagnostics.previewRustcOutput": true,
  "rust-analyzer.diagnostics.styleLints.enable": true,
  "rust-analyzer.hover.actions.references.enable": true,
  "rust-analyzer.lens.references.adt.enable": true,
  "rust-analyzer.lens.references.enumVariant.enable": true,
  "rust-analyzer.lens.references.method.enable": true,
  "rust-analyzer.lens.references.trait.enable": true,
  "rust-analyzer.linkedProjects": [
    "src/rust/Cargo.toml"
  ],
  "rust-analyzer.restartServerOnConfigChange": true,
  "rust-analyzer.semanticHighlighting.operator.specialization.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.separate.macro.bang": true,
  "rust-analyzer.semanticHighlighting.punctuation.specialization.enable": true,
  "rust-analyzer.showSyntaxTree": true,
  "rust-analyzer.workspace.symbol.search.kind": "all_symbols",
  "search.exclude": {
    "pnpm-lock.yaml": true,
    "src/go/go.sum": true,
    "src/rust/Cargo.lock": true
  }
}
